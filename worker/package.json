{
  "name": "@goldenman/domain-check-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir ../dist/worker",
    "check": "tsc --noEmit",
    "format": "prettier --check src package.json tsconfig.json ../wrangler.jsonc",
    "lint": "eslint src",
    "test": "vitest run",
    "validate:config": "wrangler deploy --dry-run --outdir ../dist/wrangler-validation"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260820.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
